# Keep generated vendor shader strings intact; their whitespace is intentional.
assets/app/** -whitespace linguist-generated=true
# Generated documents may contain only ASCII; keep byte offsets and CRCs intact.
*.pdf binary
*.pptx binary
*.zip binary
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.woff binary
*.woff2 binary
*.jpeg binary
*.gif binary
mawrid-system/client/assets/*.js -whitespace linguist-generated=true
mawrid-system/client/plant3d/assets/** -whitespace linguist-generated=true
mawrid-final/dist/assets/** -whitespace linguist-generated=true
output/** -whitespace linguist-generated=true
# Preserve published CSV byte streams and verbatim upstream license texts.
*.csv -whitespace
assets/licenses/** -whitespace
# Preserve immutable research source hashes while checking other whitespace.
ml/** whitespace=-blank-at-eof
