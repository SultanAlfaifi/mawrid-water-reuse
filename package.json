{
  "name": "mawrid-water-reuse",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "MAWRID project website, local water-reuse digital twin and public-data anomaly-detection research",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-site.mjs",
    "check": "node --test tests/*.test.mjs",
    "check:system": "node --test mawrid-system/client/test-*.mjs",
    "check:scene": "node --test mawrid-system/plant3d/test-*.mjs",
    "check:repo": "node scripts/check-repository.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "gsap": "3.15.0",
    "marked": "18.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
